# Copy to .env and set real values. Never commit .env.

# --- required by docker compose -------------------------------------------------
POSTGRES_PASSWORD=
# Key for admin operations (start training, activate a model, ...). Use a long random value,
# e.g.  python -c "import secrets; print(secrets.token_urlsafe(32))"
DIAGNOSERL_ADMIN_API_KEY=

# --- optional -------------------------------------------------------------------
# Browser-visible API URL baked into the frontend build.
PUBLIC_API_URL=http://localhost:8000

# --- local (non-docker) development: read by the API / worker -------------------
# DIAGNOSERL_ENVIRONMENT=dev
# DIAGNOSERL_DATABASE_URL=sqlite:///artifacts/diagnoserl.db
# DIAGNOSERL_ARTIFACT_DIR=artifacts
# DIAGNOSERL_CORS_ORIGINS=["http://localhost:3000"]
# DIAGNOSERL_EXPENSIVE_RATE_LIMIT_PER_MINUTE=6
